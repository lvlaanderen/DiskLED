IDD_DIALOG_ABOUT DIALOGEX 0, 0, 250, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DiskLED"
FONT 10, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,192,172,50,14
    ICON            IDI_ICON5,IDC_ABOUT_ICON1,12,12,18,16
    CONTROL         "Original DiskLED by Helge Klein (<a href=""https://helgeklein.com/"" target=""_blank"">https://helgeklein.com/</a>)",IDC_SYSLINK_URL1,
                    "SysLink",WS_TABSTOP,48,18,192,12
    CONTROL         "<a href=""https://helgeklein.com/free-tools/diskled/"" target=""_blank"">https://helgeklein.com/free-tools/diskled/</a>",IDC_SYSLINK_URL2,
                    "SysLink",WS_TABSTOP,48,48,192,12
    LTEXT           "Homepage of the original DiskLED:",IDC_TEXT2,48,36,192,8
    ICON            IDI_ICON4,IDC_ABOUT_ICON2,12,30,18,16
    ICON            IDI_ICON3,IDC_ABOUT_ICON3,12,48,18,16
    ICON            IDI_ICON2,IDC_ABOUT_ICON4,12,66,18,16
    ICON            IDI_ICON1,IDC_ABOUT_ICON5,12,84,18,16
    LTEXT           "DiskLED is a flexible system activity indicator applet for the system tray. It can display data from any performance counter. By default, it displays disk activity by flickering, just as the physical hard disk LED in many computer cases.",IDC_TEXT3,48,66,192,42,0,WS_EX_TRANSPARENT
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,12,112,228,1
    LTEXT           "This is DiskLED 2.1, a fork of Helge Klein's DiskLED by Lourens Vlaanderen. It adds more icon types, colours, a second counter, warnings, an automatic scale and other improvements, and uses the same Apache 2.0 license. Thank you, Helge, for the original!",IDC_TEXT4,12,118,228,42
    CONTROL         "Download and source of this version: <a href=""https://github.com/lvlaanderen/DiskLED/releases"" target=""_blank"">releases</a>, <a href=""https://github.com/lvlaanderen/DiskLED"" target=""_blank"">repository</a>",IDC_SYSLINK_URL3,
                    "SysLink",WS_TABSTOP,12,154,228,12
END

IDD_DIALOG_CONFIG DIALOGEX 0, 0, 548, 326
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_CAPTION | WS_SYSMENU
CAPTION "DiskLED Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Meters:",IDC_LABEL_METERS,7,9,60,8
    LISTBOX         IDC_LIST_METERS,7,20,120,184,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Add meter",IDC_ADD_METER,7,210,60,14
    PUSHBUTTON      "&Remove",IDC_REMOVE_METER,70,210,57,14
    LTEXT           "&Name:",IDC_LABEL_METERNAME,135,9,26,8
    EDITTEXT        IDC_EDIT_METERNAME,164,7,150,12,ES_AUTOHSCROLL
    CONTROL         "",IDC_TAB_MAIN,"SysTabControl32",WS_TABSTOP,135,30,316,12
    LTEXT           "Icon type:",IDC_LABEL_ICONTYPE,459,9,82,8
    COMBOBOX        IDC_COMBO_ICONTYPE,459,20,82,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT           "Preview:",IDC_LABEL_PREVIEW,459,40,82,8
    CONTROL         "",IDC_PREVIEW,"Static",SS_OWNERDRAW,459,50,82,82,WS_EX_CLIENTEDGE
    LTEXT           "Quick pick:",IDC_QUICKPICK_TEXT,135,52,45,8
    COMBOBOX        IDC_COMBO_QUICKPICK,183,50,200,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Object:",IDC_COUNTERPATH_TEXT2,135,72,40,8
    COMBOBOX        IDC_PERF_OBJECTS,135,82,316,12,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Counter:",IDC_COUNTERPATH_TEXT3,135,100,40,8
    COMBOBOX        IDC_PERF_COUNTERS,135,110,316,12,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Instance:",IDC_COUNTERPATH_TEXT4,135,128,40,8
    COMBOBOX        IDC_PERF_INSTANCES,135,138,316,12,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Description:",IDC_COUNTERPATH_TEXT5,135,156,50,8
    EDITTEXT        IDC_PERF_DESCRIPTION,135,166,316,40,ES_MULTILINE | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "Build path from &selection",IDC_USE_SELECTED_DATA_SOURCE,135,212,112,14
    LTEXT           "&Performance counter path used as data source:",IDC_COUNTERPATH_TEXT,135,232,200,8
    EDITTEXT        IDC_COUNTERPATH_EDIT,135,242,316,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Which counter value is a full icon (100%)? Use 100 for percent counters. With the Auto scale below, DiskLED learns the maximum itself and this is only the minimum.",IDC_100PERCENT_TEXT,135,52,316,26
    LTEXT           "&100% utilization:",IDC_100PERCENT_TEXT2,135,84,60,8
    EDITTEXT        IDC_100PERCENT_EDIT,203,82,70,12,ES_RIGHT | ES_AUTOHSCROLL
    LTEXT           "",IDC_LINKSPEED_TEXT,135,102,170,8
    PUSHBUTTON      "Use",IDC_USE_LINKSPEED,311,98,50,14
    LTEXT           "Value for&mat:",IDC_VALUEFORMAT_TEXT,135,124,50,8,WS_GROUP
    COMBOBOX        IDC_COMBO_VALUEFORMAT,188,122,60,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Scal&e:",IDC_SCALEMODE_TEXT,254,124,24,8
    COMBOBOX        IDC_COMBO_SCALEMODE,280,122,50,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "In&vert",IDC_CHECK_INVERT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,336,123,48,10
    LTEXT           "Colours:",IDC_COLORS_TEXT,135,54,34,8
    CONTROL         "",IDC_COLOR_LOW,"Button",BS_OWNERDRAW | WS_TABSTOP,173,51,24,13
    CONTROL         "",IDC_COLOR_MID,"Button",BS_OWNERDRAW | WS_TABSTOP,201,51,24,13
    CONTROL         "",IDC_COLOR_HIGH,"Button",BS_OWNERDRAW | WS_TABSTOP,229,51,24,13
    LTEXT           "Mid from",IDC_MIDFROM_TEXT,263,54,32,8
    EDITTEXT        IDC_EDIT_THRESHOLD_MID,296,51,22,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%, high from",IDC_HIGHFROM_TEXT,320,54,48,8
    EDITTEXT        IDC_EDIT_THRESHOLD_HIGH,370,51,22,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%",IDC_PERCENT_TEXT,394,54,8,8
    LTEXT           "How often should DiskLED get new performance data and update its icons (all meters)? Enter a value in milliseconds for the interval between consecutive updates.",IDC_100PERCENT_TEXT3,135,76,316,26
    LTEXT           "Update &frequency:",IDC_UPDATEFREQUENCY_TEXT1,135,108,62,8
    EDITTEXT        IDC_UPDATEFREQUENCY_EDIT,203,106,30,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ms",IDC_UPDATEFREQUENCY_TEXT2,235,108,10,8
    LTEXT           "Show a notification when the value stays above a percentage of the scale (the value that fills the icon) for a set time. With the Peak, Decay and Auto scale the scale follows the highest recent values.",IDC_WARN_TEXT4,135,52,316,26
    LTEXT           "Wa&rn above",IDC_WARN_TEXT1,135,86,40,8
    EDITTEXT        IDC_EDIT_ALERT_PERCENT,178,83,22,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "% of the scale, for",IDC_WARN_TEXT2,203,86,64,8
    EDITTEXT        IDC_EDIT_ALERT_SECONDS,270,83,22,12,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "s  (0% = no warning)",IDC_WARN_TEXT3,295,86,100,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,264,534,1
    CONTROL         "Start with &Windows",IDC_CHECK_AUTOSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,272,120,10
    PUSHBUTTON      "&Default values",IDC_DEFAULTVALUES,7,304,65,14
    LTEXT           "",IDC_STATUS_TEXT,80,307,290,8
    DEFPUSHBUTTON   "&Save",IDC_SAVE,377,304,50,14
    PUSHBUTTON      "Re&vert",IDC_REVERT,434,304,50,14
    PUSHBUTTON      "Close",IDCANCEL,491,304,50,14
END

